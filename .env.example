LISTEN_ADDR=0.0.0.0:20516
CACHE_DIR=/data
CACHE_MAX_GB=10
MANIFEST_TTL_SECS=60
MANIFEST_CACHE_ENTRIES=2048
MAX_CONCURRENT_REQUESTS=128
UPSTREAM_CONNECT_TIMEOUT_SECS=10
MAX_REDIRECTS=8
SHUTDOWN_DRAIN_TIMEOUT_SECS=30
RUST_LOG=info

# 可选：显式指定对外 origin（默认从请求 Host 头推导，LAN 部署一般不用改）
# PUBLIC_ORIGIN=http://192.168.1.107:20516

# 上游默认官方 Docker Hub / GHCR；直连受限的网络可切换到可达的镜像源，例如：
# DOCKERHUB_REGISTRY_URL=https://docker.m.daocloud.io
# DOCKERHUB_TOKEN_URL=https://m.daocloud.io/auth/token
# DOCKERHUB_TOKEN_SERVICE=docker.m.daocloud.io

# 上游 blob 重定向可能落到的额外 CDN 域名（逗号分隔）
# REDIRECT_HOSTS=cdn.example.com
